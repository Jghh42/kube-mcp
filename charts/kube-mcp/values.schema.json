{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "authentication", "secretHmacKeySecret", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "dotnetEnvironment": { "type": "string", "enum": ["Production", "Development", "Staging"] },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automountServiceAccountToken", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "authentication": {
      "type": "object",
      "required": ["mode", "apiKeySecret"],
      "properties": {
        "mode": { "type": "string", "enum": ["ApiKey", "None"] },
        "apiKeySecret": { "$ref": "#/definitions/secretReference" }
      }
    },
    "secretHmacKeySecret": { "$ref": "#/definitions/secretReference" },
    "allowedHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[^;[:space:]]+$",
        "not": { "const": "*" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  },
  "definitions": {
    "secretReference": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    }
  }
}
